[Unit]
Description=SVVR Telegram reporting bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=svvr
Group=svvr
WorkingDirectory=/opt/svvr-osushenie-bot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# The existing reminder code adds three hours itself.
Environment=TZ=UTC
ExecStart=/opt/svvr-osushenie-bot/.venv/bin/python main.py
Restart=always
RestartSec=15
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/svvr-osushenie-bot/DB /opt/svvr-osushenie-bot/report_info /opt/svvr-osushenie-bot/feedbacks_temp
MemoryMax=512M

[Install]
WantedBy=multi-user.target
